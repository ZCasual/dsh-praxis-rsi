{
  "name": "@local/dsh-praxis",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Praxis Cockpit: an RSI research cockpit for DSH with parallel inquiry branches, live agent-team projection, governance gates, and an evidence ledger.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build-client.mjs",
    "client/*.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "check:client": "node build-client.mjs --check",
    "test": "node --test ../../test/praxis/*.test.js"
  }
}
